# Local SQLite filename. The file is stored under web/data/local/.
DATABASE_FILENAME=prior-auth.db

# Opaque login sessions expire after this many hours.
SESSION_TTL_HOURS=12

# Development-only first-admin seed values. Choose a strong password locally.
# Never commit a real password or copy these values into production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=Prototype Administrator
SEED_ADMIN_PASSWORD=

# Trusted public origin used only to resolve social-preview metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only OpenAI configuration for on-demand synthetic TXT extraction.
# Never prefix this key with NEXT_PUBLIC_ or commit a real key.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.4-mini
# Optional model used for server-side communication drafting; falls back to the document model.
OPENAI_COMMUNICATION_MODEL=gpt-5.4-mini
